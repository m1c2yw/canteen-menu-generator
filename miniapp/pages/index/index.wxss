/* ===== 头部 ===== */
.header {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  padding: 40rpx 32rpx 36rpx;
  text-align: center;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  letter-spacing: 4rpx;
}
.sub {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 8rpx;
  display: block;
  font-weight: 400;
}

/* ===== 状态 ===== */
.loading, .error {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* ===== 菜单列表 ===== */
.menu-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.menu-list .day-card + .day-card {
  margin-top: 20rpx;
}

/* ===== 日卡片 ===== */
.day-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.day-card.holiday {
  opacity: 0.5;
}

/* 卡头 */
.day-header {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  padding: 18rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.day-card.holiday .day-header {
  background: linear-gradient(135deg, #B0B0B0, #C0C0C0);
}
.day-name {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.day-date {
  font-size: 24rpx;
  opacity: 0.75;
  font-weight: 400;
}

/* 节假日 */
.holiday-notice {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* 卡片内容 */
.day-body {
  padding: 24rpx;
}

/* ===== 区段 ===== */
.section {
  margin-bottom: 20rpx;
}
.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B35;
  display: block;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
  letter-spacing: 1rpx;
}

/* ===== 菜品行 ===== */
.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.dish-info {
  display: flex;
  align-items: center;
  flex: 1;
}
.dish-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}
.dish-name {
  font-size: 28rpx;
  color: #2D3436;
}

/* ===== 评分 ===== */
.dish-rating {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}
.stars {
  font-size: 22rpx;
  color: #FF6B35;
  letter-spacing: 2rpx;
}
.rating-num {
  font-size: 20rpx;
  color: #999;
  margin-left: 4rpx;
}

/* ===== 菜系标签 ===== */
.dish-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.tag-sichuan {
  background: #FFF3EE;
  color: #FF6B35;
  border: 1px solid #FFD4C2;
}
.tag-other {
  background: #F5F6FA;
  color: #888;
  border: 1px solid #E8E8ED;
}

/* ===== 分隔线 ===== */
.divider {
  height: 1px;
  background: #F0F0F3;
  margin: 16rpx 0;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: #999;
  letter-spacing: 2rpx;
}
