.header { background: linear-gradient(180deg, #6b1010, #8b1a1a); color: #f5deb3; padding: 36rpx 24rpx 32rpx; text-align: center; border-bottom: 4rpx solid #b8943c; }
.title { font-size: 38rpx; font-weight: 900; display: block; letter-spacing: 8rpx; }
.sub { font-size: 22rpx; opacity: 0.65; margin-top: 8rpx; display: block; letter-spacing: 2rpx; }

.loading, .error { text-align: center; padding: 100rpx 0; font-size: 28rpx; color: #8b7355; }

.menu-list { padding: 20rpx 20rpx; display: flex; flex-direction: column; gap: 18rpx; }

.day-card { background: #fffdf8; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(139,26,26,0.05); border: 1rpx solid rgba(212,197,178,0.3); }
.day-card.holiday { opacity: 0.45; }

.day-header { background: linear-gradient(90deg, #8b1a1a, #a02020); color: #f5deb3; padding: 16rpx 24rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #b8943c; }
.day-card.holiday .day-header { background: linear-gradient(90deg, #8b8378, #9b9388); border-bottom: 1rpx solid #c0b8a8; }
.day-name { font-size: 30rpx; font-weight: 700; letter-spacing: 4rpx; }
.day-date { font-size: 22rpx; opacity: 0.65; }

.holiday-notice { text-align: center; padding: 60rpx 0; font-size: 28rpx; color: #8b7355; letter-spacing: 4rpx; }

.day-body { padding: 20rpx 24rpx; }

.section { margin-bottom: 14rpx; }
.section-label { font-size: 22rpx; font-weight: 700; color: #8b1a1a; display: block; margin-bottom: 6rpx; padding-bottom: 6rpx; border-bottom: 1rpx dotted #d4c5b2; letter-spacing: 2rpx; }

.dish-row { display: flex; justify-content: space-between; align-items: center; padding: 5rpx 0; }
.dish-name { font-size: 28rpx; }

.dish-tag { font-size: 20rpx; padding: 2rpx 10rpx; }
.tag-sichuan { background: #fdf0ed; color: #8b1a1a; border: 1rpx solid #e8c8c0; }
.tag-other { background: #f5efe6; color: #8b7355; border: 1rpx solid #d4c5b2; }

.divider { border-top: 1rpx solid #e8ddd0; margin: 10rpx 0; }

.footer { text-align: center; padding: 30rpx; font-size: 22rpx; color: #8b7355; letter-spacing: 2rpx; }
